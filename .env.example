# Plantilla de configuración de Claw.
#
#   cp .env.example .env
#
# También puedes poner el .env dentro de la carpeta de datos si usas
# PICKLEBRAIN_DATA_DIR (por ejemplo con Homebrew: ~/.local/share/claw/data/.env).
# Las variables del entorno tienen prioridad sobre este archivo.

# ---------------------------------------------------------------- IA local
OLLAMA_URL=http://127.0.0.1:11434
# Modelo que conversa (necesita ~3 GB de RAM/VRAM)
OLLAMA_MODEL=qwen3:4b
# Modelo de respaldo si el principal no termina
OLLAMA_MODEL_FALLBACK=qwen2.5:3b
# Modelo pequeño para apuntar deberes y exámenes
OLLAMA_MODEL_BRAIN=qwen2.5:3b
# OLLAMA_TIMEOUT_MS=120000
# OLLAMA_KEEP_ALIVE=30m

# ----------------------------------------------------------------- WhatsApp
# El grupo se fija por identificador, o escribiendo "!claw aqui" dentro del grupo.
# Nunca por nombre: el nombre se repite entre grupos y cualquiera lo cambia.
# WHATSAPP_GROUP_JID=
# Tu número, para los comandos de dueño (si no, se detecta de la sesión)
# WHATSAPP_OWNER_JID=34600000000
# Administradores extra, separados por comas
# WHATSAPP_ADMINS=

# --------------------------------------------------------------- Web y API
# El servidor escucha siempre en 127.0.0.1:3000 (se puede cambiar con PORT).
# PORT=3000
# WEB_ALLOWED_ORIGINS=
# Cámbialo o déjalo vacío para desactivar el acceso de depuración.
WEB_DEBUG_CODE=0912

# Correo para los códigos de acceso de estudiantes
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=ClawBot <clawbot@astermail.org>

# ------------------------------------------------------------------- Datos
# Carpeta de datos (sesión de WhatsApp, SQLite, fotos, modelos).
# PICKLEBRAIN_DATA_DIR=./data
# PICKLEBRAIN_DB=./data/picklebrain.db
# MEDIA_DIR=./data/media
LOG_LEVEL=info
TZ=Europe/Madrid

# -------------------------------------------------------------------- Voz
TRANSCRIBE_ENABLED=true
# todo | contexto | nada
TRANSCRIBE_MODE=todo
TRANSCRIBE_MAX_SECONDS=180
# Respaldo en Node (solo si no usas el servicio Python)
# WHISPER_MODEL=Xenova/whisper-base
# FFMPEG_PATH=ffmpeg
SHOW_TRANSCRIPTIONS=false

# -------------------------------------------- Servicio Python (voz/imágenes)
# Node lo usa si responde en /health; si no, cae a los motores antiguos.
PYTHON_AI_ENABLED=true
PYTHON_AI_URL=http://127.0.0.1:5050
# PYTHON_AI_TIMEOUT_MS=120000
# PYTHON_AI_HEALTH_TIMEOUT_MS=2500
# PYTHON_AI_FALLBACK=true

# Voz con faster-whisper
# PYTHON_WHISPER_MODEL=base
# PYTHON_WHISPER_DEVICE=auto
# PYTHON_WHISPER_COMPUTE=
# PYTHON_WHISPER_LANGUAGE=es
# PYTHON_WHISPER_BEAM=5

# Imágenes con diffusers
# PYTHON_IMAGE_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
# PYTHON_IMAGE_DEVICE=auto
# Con 4 GB de VRAM, libera el modelo tras cada imagen.
# PYTHON_IMAGE_UNLOAD=true
# PYTHON_IMAGE_MAX_SIDE=1024
# PYTHON_MODELS_DIR=./data/models

# --------------------------------------------------------------- Imágenes
# Apagadas de fábrica. Solo se generan con "!claw imagen ..." y el ajuste activo.
IMAGE_GEN_ENABLED=false
# auto | python | cli | http
IMAGE_GEN_BACKEND=auto
# IMAGE_GEN_STEPS=20
# IMAGE_GEN_WIDTH=512
# IMAGE_GEN_HEIGHT=512
# IMAGE_GEN_CFG=7
# IMAGE_GEN_SAMPLER=dpm++2m
# IMAGE_GEN_SCHEDULER=karras
# IMAGE_GEN_SEED=-1
# IMAGE_GEN_ENHANCE=true
# IMAGE_GEN_FREE_VRAM=true
# IMAGE_GEN_TIMEOUT=300
# Motor cli (stable-diffusion.cpp)
# IMAGE_GEN_BIN=./sdserver/sd-cli.exe
# IMAGE_GEN_MODEL_PATH=./sdserver/models/v1-5-pruned_Q4_K.gguf
# Motor http (compatible con OpenAI Images)
# IMAGE_GEN_ENDPOINT=http://127.0.0.1:1234/v1/images/generations
# IMAGE_GEN_MODEL=
# IMAGE_GEN_API_KEY=

# ------------------------------------------------------ Recordatorios y avisos
REMINDER_ENABLED=true
REMINDER_HOUR=20
REMINDER_MORNING_HOUR=8
REMINDER_ADVANCE_DAYS=3
SUMMARY_ENABLED=true
WELCOME_ENABLED=true

# ----------------------------------------------------------- Fotos y limpieza
MEDIA_ENABLED=true
# contexto | todo | nada
MEDIA_MODE=contexto
MEDIA_RETENTION_DAYS=14
MEDIA_MAX_MB=12
MEDIA_MIN_FREE_MB=800
CLEANUP_INTERVAL_MINUTES=60
