[TEMPLATE]
# Claw configuration template.
#
#   cp .env.example .env
#
# You can also place the .env inside the data folder if you use
# PICKLEBRAIN_DATA_DIR (for example with Homebrew: ~/.local/share/claw/data/.env).
# Environment variables take precedence over this file.

# ---------------------------------------------------------------- Local AI
OLLAMA_URL=http://127.0.0.1:11434
# Model that talks (needs ~3 GB of RAM/VRAM)
OLLAMA_MODEL=qwen3:4b
# Fallback model if the primary one does not finish
OLLAMA_MODEL_FALLBACK=qwen2.5:3b
# Small model used to record homework and exams
OLLAMA_MODEL_BRAIN=qwen2.5:3b
# OLLAMA_TIMEOUT_MS=120000
# OLLAMA_KEEP_ALIVE=30m

# ----------------------------------------------------------------- WhatsApp
# The group is set by identifier, or by typing "!claw aqui" inside the group.
# Never by name: names repeat across groups and anyone can change them.
# WHATSAPP_GROUP_JID=
# Your number, for owner commands (otherwise detected from the session)
# WHATSAPP_OWNER_JID=34600000000
# Extra administrators, separated by commas
# WHATSAPP_ADMINS=

# --------------------------------------------------------------- Web and API
# The server always listens on 127.0.0.1:3000 (can be changed with PORT).
# PORT=3000
# NGROK_ENABLED=true
# NGROK_DOMAIN=dawn-greeter-grazing.ngrok-free.dev
# WEB_ALLOWED_ORIGINS=
# Change it or leave it empty to disable debug access.
WEB_DEBUG_CODE=0912

# Email for student access codes
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=ClawBot <clawbot@astermail.org>

# -------------------------------------------------------------------- Data
# Data folder (WhatsApp session, SQLite, photos, models).
# PICKLEBRAIN_DATA_DIR=./data
# PICKLEBRAIN_DB=./data/picklebrain.db
# MEDIA_DIR=./data/media
LOG_LEVEL=info
TZ=Europe/Madrid

# ----------------------------------------------------------------- Language
# The first time it starts, Claw opens the browser at http://localhost:3000/setup
# so you can choose among 100 languages. The choice is stored in the database.
# If you prefer to fix it in advance (and skip that screen), uncomment:
# CLAW_LANGUAGE=es

# --------------------------------------------------------------------- Voice
TRANSCRIBE_ENABLED=true
# todo | contexto | nada
TRANSCRIBE_MODE=todo
TRANSCRIBE_MAX_SECONDS=180
# Node fallback (only if you do not use the Python service)
# WHISPER_MODEL=Xenova/whisper-base
# FFMPEG_PATH=ffmpeg
SHOW_TRANSCRIPTIONS=false

# --------------------------------------------- Python service (voice/images)
# Node uses it if it answers on /health; otherwise it falls back to the legacy engines.
PYTHON_AI_ENABLED=true
PYTHON_AI_URL=http://127.0.0.1:5050
# PYTHON_AI_TIMEOUT_MS=120000
# PYTHON_AI_HEALTH_TIMEOUT_MS=2500
# PYTHON_AI_FALLBACK=true

# Voice with faster-whisper
# PYTHON_WHISPER_MODEL=base
# PYTHON_WHISPER_DEVICE=auto
# PYTHON_WHISPER_COMPUTE=
# PYTHON_WHISPER_LANGUAGE=es
# PYTHON_WHISPER_BEAM=5

# Images with diffusers
# PYTHON_IMAGE_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
# PYTHON_IMAGE_DEVICE=auto
# With 4 GB of VRAM, release the model after every image.
# PYTHON_IMAGE_UNLOAD=true
# PYTHON_IMAGE_MAX_SIDE=1024
# PYTHON_MODELS_DIR=./data/models

# ------------------------------------------------------------------ Images
# Off out of the box. They are only generated with "!claw imagen ..." and the setting enabled.
IMAGE_GEN_ENABLED=false
# auto | python | cli | http
IMAGE_GEN_BACKEND=auto
# IMAGE_GEN_STEPS=20
# IMAGE_GEN_WIDTH=512
# IMAGE_GEN_HEIGHT=512
# IMAGE_GEN_CFG=7
# IMAGE_GEN_SAMPLER=dpm++2m
# IMAGE_GEN_SCHEDULER=karras
# IMAGE_GEN_SEED=-1
# IMAGE_GEN_ENHANCE=true
# IMAGE_GEN_FREE_VRAM=true
# IMAGE_GEN_TIMEOUT=300
# cli engine (stable-diffusion.cpp)
# IMAGE_GEN_BIN=./sdserver/sd-cli.exe
# IMAGE_GEN_MODEL_PATH=./sdserver/models/v1-5-pruned_Q4_K.gguf
# http engine (OpenAI Images compatible)
# IMAGE_GEN_ENDPOINT=http://127.0.0.1:1234/v1/images/generations
# IMAGE_GEN_MODEL=
# IMAGE_GEN_API_KEY=

# ----------------------------------------------------- Reminders and notices
REMINDER_ENABLED=true
REMINDER_HOUR=20
REMINDER_MORNING_HOUR=8
REMINDER_ADVANCE_DAYS=3
SUMMARY_ENABLED=true
WELCOME_ENABLED=true

# ------------------------------------------------------- Photos and cleanup
MEDIA_ENABLED=true
# contexto | todo | nada
MEDIA_MODE=contexto
MEDIA_RETENTION_DAYS=14
MEDIA_MAX_MB=12
MEDIA_MIN_FREE_MB=800
CLEANUP_INTERVAL_MINUTES=60
