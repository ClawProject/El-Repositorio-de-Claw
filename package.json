{
  "name": "picklebrain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bot de WhatsApp con IA local para un grupo de instituto: aprende los deberes y los examenes del grupo y los recuerda.",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "web": "node src/web.js",
    "sim": "node src/tools/simulate.js",
    "doctor": "node src/tools/doctor.js",
    "test": "node src/tools/test.js",
    "test:subjects": "node --test src/tools/subjects-test.js",
    "test:web": "node --test src/tools/server-test.js src/tools/web-auth-test.js",
    "test:ai": "node src/tools/ai-test.js",
    "test:voice": "node src/tools/voice-test.js",
    "test:vetados": "node src/tools/vetados-test.mjs",
    "test:i18n": "node src/tools/i18n-test.mjs",
    "test:python": "node --test src/tools/python-ai-test.js",
    "ia": "python python/server.py",
    "ia:linux": "python3 python/server.py",
    "qr": "node src/tools/qr-test.js",
    "enviar": "node src/tools/enviar.js",
    "smoke": "node src/tools/smoke.js",
    "smtp": "node src/tools/smtp-test.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@whiskeysockets/baileys": "^6.7.0",
    "chess.js": "^1.4.0",
    "nodemailer": "^10.3.1",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0"
  }
}
